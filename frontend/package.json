{
  "name": "sendik-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ng": "ng",
    "start": "node --env-file-if-exists=../.env node_modules/@angular/cli/bin/ng.js serve",
    "build": "node --env-file-if-exists=../.env node_modules/@angular/cli/bin/ng.js build",
    "watch": "node --env-file-if-exists=../.env node_modules/@angular/cli/bin/ng.js build --watch --configuration development",
    "serve:ssr": "node --env-file-if-exists=../.env dist/sendik/server/server.mjs",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:completo": "playwright test --config playwright.completo.config.ts",
    "lint": "ng lint && prettier --check .",
    "format": "prettier --write .",
    "verify": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@angular/common": "^21.2.22",
    "@angular/compiler": "^21.2.22",
    "@angular/core": "^21.2.22",
    "@angular/forms": "^21.2.22",
    "@angular/platform-browser": "^21.2.22",
    "@angular/platform-server": "^21.2.22",
    "@angular/router": "^21.2.22",
    "@angular/ssr": "^21.2.22",
    "@jsverse/transloco": "^8.4.0",
    "@tanstack/angular-query-experimental": "5.101.4",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.22",
    "@angular/cli": "^21.2.22",
    "@angular/compiler-cli": "^21.2.22",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.9.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.8"
  }
}
